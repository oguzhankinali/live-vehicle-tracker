{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=VehicleTrackerDb;Username=postgres;Password=password123"
  },
  "Entur": {
    "FeedUrl": "https://api.entur.io/realtime/v1/gtfs-rt/vehicle-positions",
    "ClientName": "OGZHAN-LiveVehicleTracker",
    "TimeoutSeconds": 10
  },
  "Ingestion": {
    "PollInterval": "00:00:03",
    "Retention": "03:00:00",
    "CleanupInterval": "00:01:00",
    "ChunkInterval": "00:05:00"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}